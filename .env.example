# ==============================================================================
# AI Traffic Vision - Environment Configuration (.env)
# ==============================================================================

APP_NAME=AI Traffic Vision
VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8080

# SQLite Persistent Database
DATABASE_URL=sqlite:///./data/traffic_vision.db

# Physical Speed & 50 km/h Rule Settings
SPEED_LIMIT_KMH=50.0
SPEED_DISPLAY_DECIMALS=1
SPEEDING_CONFIRMATION_SECONDS=1.5
MAX_CONFIRMED_WARNINGS=3
WARNING_COOLDOWN_SECONDS=10.0
MEASUREMENT_TOLERANCE_KMH=0.0

# Model Paths
VEHICLE_MODEL_PATH=models/vehicle_detector/yolov8n.pt
PLATE_DETECTOR_MODEL_PATH=models/plate_detector/best.pt
PLATE_OCR_MODEL_PATH=models/plate_ocr
MOTORCYCLE_PLATE_OCR_MODEL_PATH=models/motorcycle_plate_ocr

# Storage Roots
DATASET_ROOT=./datasets
MODEL_ROOT=./models
EVIDENCE_ROOT=./data/evidence
UPLOADS_ROOT=./data/uploads
REPORTS_ROOT=./data/reports

# Retention and Privacy
EVIDENCE_RETENTION_DAYS=90
